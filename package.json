{
  "name": "kitanda",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gestão de stock e vendas para pequenas lojas — API REST + React (TypeScript)",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0"
  },
  "engines": {
    "node": ">=22"
  }
}
