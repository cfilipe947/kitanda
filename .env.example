# Copia para .env e para apps/api/.env  (cp .env.example .env)

NODE_ENV=development
PORT=3333

DATABASE_URL=postgresql://kitanda:kitanda@localhost:5432/kitanda
DATABASE_URL_TEST=postgresql://kitanda:kitanda@localhost:5432/kitanda_test

# Gera com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troca-isto-por-um-segredo-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=8h

CORS_ORIGIN=http://localhost:5173

# "true" activa POST /api/v1/demo/start: o botão "Experimentar a demo" repõe os dados
# padrão a cada entrada (apaga o que outros visitantes criaram). Só para a demo pública.
DEMO_MODE=true

# Frontend (Vite só expõe variáveis com prefixo VITE_)
VITE_API_URL=http://localhost:3333/api/v1
